# =======================================================
# CONFIGURAÇÕES DE AMBIENTE - PROJETO ENGENHARIA DE DADOS
# =======================================================

# PostgreSQL (AWS RDS) - Parte 1 (Operacional) e Parte 3 (Esquema Estrela)
POSTGRES_HOST=seu-rds-postgres.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB_OPERACIONAL=universidade
POSTGRES_DB_DW=universidade_dw

# MongoDB (AWS DocumentDB / EC2 / Atlas) - Parte 2
MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=universidade_nosql

# Modo Demonstração Local (opcional: True usa SQLite/Mock para testes locais sem internet/AWS)
USE_LOCAL_FALLBACK=False
